      "id": "Prepare_CSV_Request",
      "name": "Prepare CSV Request",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -280,
        180
      ]
    },
    {
      "parameters": {
        "jsCode": "const sourceName = $json.source_name || 'csv_pipeline_import';\nconst provider = $json.provider || 'mock';\nconst csvContent = $json.csv_content || '';\n\nfunction splitCsvLine(line) {\n  const values = [];\n  let current = '';\n  let inQuotes = false;\n  for (let i = 0; i < line.length; i += 1) {\n    const char = line[i];\n    const nextChar = line[i + 1];\n    if (char === '\"') {\n      if (inQuotes && nextChar === '\"') {\n        current += '\"';\n        i += 1;\n      } else {\n        inQuotes = !inQuotes;\n      }\n      continue;\n    }\n    if (char === ',' && !inQuotes) {\n      values.push(current);\n      current = '';\n      continue;\n    }\n    current += char;\n  }\n  values.push(current);\n  return values;\n}\n\nfunction normalizeHeader(header) {\n  return String(header || '').trim().toLowerCase().replace(/ /g, '_').replace(/-/g, '_');\n}\n\nconst lines = csvContent.split(/\\r?\\n/).map((line) => line.trim()).filter(Boolean);\nif (lines.length < 2) {\n  return [{ json: { source_name: sourceName, provider, items: [] } }];\n}\n\nconst headers = splitCsvLine(lines[0]).map(normalizeHeader);\nconst items = lines.slice(1).map((line) => {\n  const values = splitCsvLine(line);\n  const row = {};\n  headers.forEach((header, index) => {\n    row[header] = (values[index] || '').trim();\n  });\n  const attachedDocuments = String(row.attached_documents || row.documents || row.pieces_jointes || '')\n    .split(',')\n    .map((item) => item.trim())\n    .filter(Boolean);\n  return {\n    source_file: sourceName,\n    channel: ['email', 'telephone', 'courrier', 'portail'].includes((row.channel || '').toLowerCase()) ? row.channel.toLowerCase() : 'email',\n    customer_id: row.customer_id || row.client_id || null,\n    contract_id: row.contract_id || row.case_id || row.dossier_id || row.claim_id || null,\n    provider,\n    claim_text: row.claim_text || row.message || row.description || '',\n    attached_documents: attachedDocuments\n  };\n});\n\nreturn [{ json: { source_name: sourceName, provider, items } }];"
      },
      "id": "Parse_CSV_To_Items",
      "name": "Parse CSV To Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -10,
